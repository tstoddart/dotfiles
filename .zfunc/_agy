#compdef agy

_agy() {
    local -a subcommands
    subcommands=(
        'agent:List available agents'
        'agents:List available agents'
        'changelog:Show changelog and release notes'
        'help:Show help for subcommands'
        'install:Configure environment paths and shell settings'
        'mcp:Manage MCP servers (add, remove, list, enable, disable)'
        'mic-serve:Serve machine microphone to CLI on another host'
        'models:List available models'
        'plugin:Manage plugins (install, uninstall, list, enable, disable)'
        'plugins:Alias for plugin'
        'remote-control:Manage remote-control background daemon (start, status, stop)'
        'update:Update CLI'
    )

    local -a global_flags
    global_flags=(
        '--add-dir[Add directory to workspace]:directory:_files -/'
        '--agent[Agent for the current CLI session]:agent:'
        '(-c --continue)'{-c,--continue}'[Continue the most recent conversation]'
        '--conversation[Resume a previous conversation by ID]:conversation:->conversations'
        '--dangerously-skip-permissions[Auto-approve all tool permission requests without prompting]'
        '--disable-slash-commands[Disable slash command and skill expansion in print mode]'
        '--effort[Reasoning effort for CLI session]:effort:(low medium high max)'
        '(-i --prompt-interactive)'{-i,--prompt-interactive}'[Run an initial prompt interactively and continue session]:prompt:'
        '--input-format[Input format for print mode]:format:(text stream-json)'
        '--json-schema[JSON schema string or path to schema file]:file:_files'
        '--log-file[Override CLI log file path]:file:_files'
        '--mode[Set agent execution mode]:mode:(accept-edits plan)'
        '--model[Model for current CLI session]:model:->models'
        '--new-project[Create a new project for this session]'
        '--output-format[Output format for print mode]:format:(text json stream-json)'
        '(-p --print --prompt)'{-p,--print,--prompt}'[Run single prompt non-interactively and print response]:prompt:'
        '--print-timeout[Optional time limit for print mode]:timeout:'
        '--project[Project ID or project name]:project:'
        '--remote-control[Create a remote connection for CLI session on start up]'
        '--sandbox[Run in sandbox with terminal restrictions enabled]'
    )

    _arguments -C \
        $global_flags \
        '1: :->subcommand' \
        '*: :->subargs'

    case $state in
        subcommand)
            _describe -t subcommands 'agy subcommand' subcommands
            ;;
        models)
            local -a models
            models=(
                'gemini-3.8-flash-high:Gemini 3.8 Flash (High)'
                'gemini-3.8-flash-medium:Gemini 3.8 Flash (Medium)'
                'gemini-3.8-flash-low:Gemini 3.8 Flash (Low)'
                'gemini-3.7-flash-high:Gemini 3.7 Flash (High)'
                'gemini-3.7-flash-medium:Gemini 3.7 Flash (Medium)'
                'gemini-3.7-flash-low:Gemini 3.7 Flash (Low)'
                'gemini-3.6-flash-high:Gemini 3.6 Flash (High)'
                'gemini-3.1-pro-high:Gemini 3.1 Pro (High)'
                'gemini-3.1-pro-low:Gemini 3.1 Pro (Low)'
                'claude-sonnet-4-6:Claude Sonnet 4.6 (Thinking)'
                'claude-opus-4-6-thinking:Claude Opus 4.6 (Thinking)'
                'gpt-oss-120b-medium:GPT-OSS 120B (Medium)'
            )
            _describe -t models 'model' models
            ;;
        conversations)
            local -a convs
            if [[ -d ~/.gemini/antigravity-cli/brain ]]; then
                convs=(${(f)"$(ls -1t ~/.gemini/antigravity-cli/brain 2>/dev/null | head -n 25)"})
                _describe -t convs 'conversation id' convs
            fi
            ;;
        subargs)
            case $words[1] in
                mcp)
                    local -a mcp_subcmds
                    mcp_subcmds=(
                        'add:Add or update an MCP server configuration'
                        'remove:Remove an MCP server configuration'
                        'list:List all configured MCP servers'
                        'enable:Enable an MCP server'
                        'disable:Disable an MCP server'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t mcp_subcmds 'mcp action' mcp_subcmds
                    elif (( CURRENT == 3 )) && [[ "$words[2]" =~ ^(remove|enable|disable)$ ]]; then
                        local -a servers
                        if [[ -f ~/.gemini/config/mcp_config.json ]]; then
                            servers=(${(f)"$(jq -r '.mcpServers | keys[]' ~/.gemini/config/mcp_config.json 2>/dev/null)"})
                            _describe -t servers 'mcp server' servers
                        fi
                    fi
                    ;;
                plugin|plugins)
                    local -a plugin_subcmds
                    plugin_subcmds=(
                        'list:List imported plugins'
                        'import:Import plugins from gemini or claude'
                        'install:Install a plugin'
                        'uninstall:Uninstall a plugin'
                        'enable:Enable a plugin'
                        'disable:Disable a plugin'
                        'validate:Validate a plugin'
                        'link:Generate link to marketplace'
                        'help:Show help'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t plugin_subcmds 'plugin action' plugin_subcmds
                    elif (( CURRENT == 3 )) && [[ "$words[2]" == "import" ]]; then
                        _values 'source' 'gemini' 'claude'
                    fi
                    ;;
                remote-control)
                    local -a rc_subcmds
                    rc_subcmds=(
                        'start:Register and start remote-control daemon'
                        'status:Show daemon status'
                        'stop:Stop daemon and unregister it'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t rc_subcmds 'remote-control action' rc_subcmds
                    fi
                    ;;
                install)
                    local -a install_flags
                    install_flags=(
                        '--dir[Custom directory target to configure PATH for]:dir:_files -/'
                        '(-h --help)'{-h,--help}'[Show help]'
                        '--skip-aliases[Bypasses shell profile alias purging]'
                        '--skip-path[Bypasses shell profile PATH appending]'
                    )
                    _arguments $install_flags
                    ;;
            esac
            ;;
    esac
}

_agy "$@"
